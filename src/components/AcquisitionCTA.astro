---
import { ACQUISITION_MAILTO, SITE } from '../config/site';

const steps = [
  { icon: 'fa-handshake', title: 'Agree on terms', text: 'Offer, intended use, and timeline confirmed by email.' },
  { icon: 'fa-vault', title: 'Fund secure escrow', text: 'Escrow.com holds funds until transfer is verified.' },
  { icon: 'fa-right-left', title: 'Domain transferred', text: 'Pushed to your registrar; escrow releases on confirmation.' },
];
---

<section id="acquire" class="reveal bg-slate-900 py-16 border-t border-slate-800">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <div
        class="inline-block px-5 py-1.5 rounded-3xl bg-white/10 text-sky-400 text-xs font-bold tracking-[1.5px] mb-4"
      >
        EXCLUSIVE OPPORTUNITY
      </div>
      <h2 class="text-white text-4xl md:text-5xl font-extrabold tracking-tighter">
        Ready to own the #1 domain for Sunport parking?
      </h2>
      <p class="mt-4 text-lg text-slate-300 max-w-md mx-auto">
        Submit your best offer today. All serious inquiries are handled confidentially. Secure escrow
        transactions strongly recommended.
      </p>
    </div>

    <ol class="max-w-3xl mx-auto grid sm:grid-cols-3 gap-4 mb-10" aria-label="Secure acquisition steps">
      {steps.map((step, i) => (
        <li class="rounded-2xl border border-white/10 bg-white/5 p-5 text-left">
          <div class="flex items-center gap-3 mb-2">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-sky-500/15 text-sky-400" aria-hidden="true">
              <i class={`fa-solid ${step.icon}`} />
            </span>
            <span class="text-xs font-bold text-slate-400 tracking-widest">STEP {i + 1}</span>
          </div>
          <p class="text-white font-bold">{step.title}</p>
          <p class="text-sm text-slate-400 mt-1">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="max-w-xl mx-auto text-center">
      <div class="bg-white rounded-3xl shadow-2xl p-8 md:p-9 border border-slate-100">
        <p class="text-xs font-bold tracking-wider text-slate-500 mb-2">ACQUISITION CONTACT</p>
        <a
          href={`mailto:${SITE.email}`}
          data-track="acquire-email"
          class="tap-target inline-block text-2xl sm:text-3xl font-display text-slate-900 hover:text-sky-600 transition-colors break-all mb-6"
        >
          {SITE.email}
        </a>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={ACQUISITION_MAILTO}
            data-track="acquire-cta"
            class="cta-button tap-target flex-1 inline-flex items-center justify-center gap-x-2 bg-sky-500 hover:bg-sky-600 text-white font-extrabold text-lg rounded-3xl px-6"
          >
            <span>Inquire About Acquisition</span>
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          </a>

          <button
            type="button"
            id="copy-email-btn"
            class="tap-target flex-1 inline-flex items-center justify-center gap-x-2 border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-lg rounded-3xl transition-all px-6"
          >
            <span id="copy-btn-text">Copy Contact Email</span>
          </button>
        </div>

        <p class="mt-6 text-[10px] text-slate-500 tracking-wider">
          Your information is kept strictly confidential. We recommend using <span
            class="font-semibold">Escrow.com</span
          > for all transactions.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function copyEmail() {
    const email = 'sales@desertrich.com';
    navigator.clipboard
      .writeText(email)
      .then(() => {
        const btn = document.getElementById('copy-btn-text');
        if (btn) {
          const original = btn.textContent;
          btn.textContent = 'Copied to clipboard!';
          setTimeout(() => {
            btn.textContent = original;
          }, 2200);
        }
      })
      .catch(() => {
        window.location.href = 'mailto:sales@desertrich.com';
      });
  }
  document.getElementById('copy-email-btn')?.addEventListener('click', copyEmail);
</script>
